[Unit]
Description=Back up Lorvex Cloud SQLite safely
RequiresMountsFor=/mnt/development/services/lorvex-cloud

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
Environment=LORVEX_CLOUD_HOME=/srv/lorvex-cloud
Environment=LORVEX_CLOUD_DB=/mnt/development/services/lorvex-cloud/data/lorvex.sqlite
Environment=LORVEX_CLOUD_BACKUP_DIR=/mnt/development/services/lorvex-cloud/backups
ExecStart=/usr/bin/python3 /srv/lorvex-cloud/backup.py
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/development/services/lorvex-cloud/backups
