[Unit]
Description=Lorvex Cloud Account and MCP Service
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/mnt/development/services/lorvex-cloud/data

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/lorvex-cloud
Environment=LORVEX_CLOUD_HOST=127.0.0.1
Environment=LORVEX_CLOUD_PORT=8769
Environment=LORVEX_CLOUD_ORIGIN=https://torah-social.tail0a6c7d.ts.net:10000/cloud
Environment=LORVEX_CLOUD_DB=/mnt/development/services/lorvex-cloud/data/lorvex.sqlite
ExecStart=/usr/local/bin/node /home/ubuntu/lorvex-cloud/server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/development/services/lorvex-cloud/data
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
